Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Remove", "[", "\"\<Global`*\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{"Tensor", "[", 
  RowBox[{"a", ",", 
   RowBox[{"{", 
    RowBox[{"j", ",", "Void"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"Void", ",", "i"}], "}"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"MatTen", "[", 
  RowBox[{"%", ",", 
   RowBox[{"{", 
    RowBox[{"4", ",", "3"}], "}"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Aa", "=", 
   RowBox[{"ExpandMat", "[", 
    RowBox[{"%", ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "j"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Tensor", "[", 
  RowBox[{"b", ",", 
   RowBox[{"{", 
    RowBox[{"k", ",", "Void"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"Void", ",", "j"}], "}"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"MatTen", "[", 
  RowBox[{"%", ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", "2"}], "}"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Bb", "=", 
   RowBox[{"ExpandMat", "[", 
    RowBox[{"%", ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "k"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{
   RowBox[{"MatrixForm", "[", "Aa", "]"}], ",", "\"\<.\>\"", ",", 
   RowBox[{"MatrixForm", "[", "Bb", "]"}], ",", "\"\<=\>\"", ",", 
   RowBox[{"MatrixForm", "[", 
    RowBox[{"Aa", ".", "Bb"}], "]"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Tensor", "[", 
   RowBox[{"a", ",", 
    RowBox[{"{", 
     RowBox[{"j", ",", "Void"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"Void", ",", "i"}], "}"}]}], "]"}], 
  RowBox[{"Tensor", "[", 
   RowBox[{"b", ",", 
    RowBox[{"{", 
     RowBox[{"k", ",", "Void"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"Void", ",", "j"}], "}"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"Sum", "[", 
  RowBox[{"%", ",", 
   RowBox[{"{", 
    RowBox[{"j", ",", "1", ",", "3"}], "}"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"MatTen", "[", 
  RowBox[{"%", ",", 
   RowBox[{"{", 
    RowBox[{"4", ",", "2"}], "}"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"AB1", "=", 
    RowBox[{"ExpandMat", "[", 
     RowBox[{"%", ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "k"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"MatrixForm", "[", 
   RowBox[{"Aa", ".", "Bb"}], "]"}], "==", 
  RowBox[{"MatrixForm", "[", "AB1", "]"}]}]}], "Input",
 CellChangeTimes->{
