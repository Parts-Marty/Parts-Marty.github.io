Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"rk", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", " ", 
      RowBox[{"Cos", "[", "s", "]"}]}], ",", 
     RowBox[{"b", " ", 
      RowBox[{"Sin", "[", "s", "]"}]}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"\"\<The square of the differential element of the ellipse arc\>\"", 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"integrand", "[", "s_", "]"}], ":=", 
  RowBox[{"Evaluate", "[", 
   RowBox[{"Sqrt", "[", 
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{"rk", ",", "s"}], "]"}], ".", 
     RowBox[{"D", "[", 
      RowBox[{"rk", ",", "s"}], "]"}]}], "]"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"\"\<The square of the differential element of the geodesic arc\>\"",
   ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sintegrand", "[", "ss_", "]"}], ":=", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"u", "[", "s", "]"}], "/.", "s30"}], ",", "s"}], "]"}], 
       ")"}], 
      RowBox[{"Sqrt", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "a"}], " ", 
           RowBox[{"Sin", "[", 
            RowBox[{"u", "[", "s", "]"}], "]"}]}], ")"}], "^", "2"}], "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"b", " ", 
           RowBox[{"Cos", "[", 
            RowBox[{"u", "[", "s", "]"}], "]"}]}], ")"}], "^", "2"}]}], 
       "]"}]}], "/.", "s30"}], "/.", 
    RowBox[{"s", "->", "ss"}]}], ")"}]}], "\[IndentingNewLine]", 
 RowBox[{"\"\<The unfolded horizontal coordinate U(s)and sU[s] arc length\>\"",
   ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"U", "[", 
   RowBox[{"s_", "?", "NumericQ"}], "]"}], ":=", 
  RowBox[{"NIntegrate", "[", 
   RowBox[{
    RowBox[{"integrand", "[", "tau", "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"tau", ",", "0", ",", "s"}], "}"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sU", "[", "s_", "]"}], ":=", 
  RowBox[{"NIntegrate", "[", 
   RowBox[{
    RowBox[{"sintegrand", "[", "ss", "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"ss", ",", "0", ",", "s"}], "}"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"\"\<The unfolded vertical coordinate Z(t)\>\"", ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Z", "[", "s_", "]"}], ":=", "s"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"sZ", "[", "s_", "]"}], ":=", "s"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"tMax", "=", 
  RowBox[{"ap", "  ", "Pi"}]}]}], "Input",
