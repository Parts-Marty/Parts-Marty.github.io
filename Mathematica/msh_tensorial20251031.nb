Cell[BoxData[{
 RowBox[{
  RowBox[{"Tensor", "[", 
   RowBox[{"g", ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "j"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"Void", ",", "Void"}], "}"}]}], "]"}], 
  RowBox[{"IndexDerivative", "[", 
   RowBox[{
    RowBox[{"x", "[", "i", "]"}], ",", "s"}], "]"}], 
  RowBox[{"IndexDerivative", "[", 
   RowBox[{
    RowBox[{"x", "[", "j", "]"}], ",", "s"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"s1", "=", 
  RowBox[{"ExpandDoubleIndex", "[", 
   RowBox[{"%", ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "j"}], "}"}]}], 
   "]"}]}], "\[IndentingNewLine]", "\"\<The lengths of the elliptic \
helix\>\"", "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"%%", "/.", 
    RowBox[{
     RowBox[{"x", "[", "1", "]"}], "->", "s"}]}], "/.", 
   RowBox[{
    RowBox[{"x", "[", "2", "]"}], "->", "s"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Integrate", "[", 
   RowBox[{
    RowBox[{"Sqrt", "[", "%", "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"s", ",", "0", ",", 
      RowBox[{"ap", " ", "Pi"}]}], "}"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"%", "//", 
  "N"}], "\[IndentingNewLine]", "\"\<The lengths of The geodesic\>\"", "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"s1", "/.", 
     RowBox[{
      RowBox[{"x", "[", "1", "]"}], "->", 
      RowBox[{"u", "[", "s", "]"}]}]}], "/.", 
    RowBox[{
     RowBox[{"x", "[", "2", "]"}], "->", 
     RowBox[{"v", "[", "s", "]"}]}]}], "/.", "s30"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"EvaluateIndexDerivative", "[", "%", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Integrate", "[", 
