Cell[CellGroupData[{

Cell["\<\
It is possible to solve this directly, but it is better to start with the \
following equation, which divides both sides of the equation for the line \
element of metric dc\[Tau]^2 by d\[Tau]^2, and thus eliminates one \
integration . Note that the various conditions obtained so far have been \
substituted in .\
\>", "Subsubsection",
 CellChangeTimes->{{3.9421041807837024`*^9, 3.942104266267609*^9}, {
  3.9421042969117565`*^9, 3.942104329688819*^9}, {3.942105001784143*^9, 
  3.9421050059104223`*^9}, {3.9440957232919188`*^9, 3.9440957242947364`*^9}},
 Background->RGBColor[
  0.88, 1, 0.88],ExpressionUUID->"3bd31002-8db8-4096-ba56-1e44ac0a27b5"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"(", "dc\[Tau]", ")"}], "^", "2"}], "==", 
  RowBox[{"-", 
   RowBox[{
    RowBox[{"(", "ds", ")"}], "^", "2"}]}], "==", 
  RowBox[{
   RowBox[{"-", 
    RowBox[{"Tensor", "[", 
     RowBox[{"g", ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "j"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"Void", ",", "Void"}], "}"}]}], "]"}]}], 
   RowBox[{"dx", "[", "i", "]"}], 
   RowBox[{"dx", "[", "j", "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"(", "dc\[Tau]", ")"}], "^", "2"}], "==", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "-", 
      RowBox[{"a", "/", 
       RowBox[{"x", "[", "2", "]"}]}]}], ")"}], 
    RowBox[{
     RowBox[{"dx", "[", "1", "]"}], "^", "2"}]}], "-", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"1", "/", 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{"a", "/", 
          RowBox[{"x", "[", "2", "]"}]}]}], ")"}]}], 
      RowBox[{
       RowBox[{"dx", "[", "2", "]"}], "^", "2"}]}], "+", 
     RowBox[{
      RowBox[{
       RowBox[{"x", "[", "2", "]"}], "^", "2"}], 
      RowBox[{
       RowBox[{"dx", "[", "3", "]"}], "^", "2"}]}], "+", 
     RowBox[{
      RowBox[{
       RowBox[{"x", "[", "2", "]"}], "^", "2"}], " ", 
      RowBox[{
       RowBox[{"Sin", "[", 
        RowBox[{"x", "[", "3", "]"}], "]"}], "^", "2"}], 
      RowBox[{
       RowBox[{"dx", "[", "4", "]"}], "^", "2"}]}]}], ")"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"%", "[", 
     RowBox[{"[", "1", "]"}], "]"}], "/", 
    RowBox[{
     RowBox[{"(", "d\[Tau]", ")"}], "^", "2"}]}], "==", 
   RowBox[{"Expand", "[", 
    RowBox[{
     RowBox[{"%", "[", 
      RowBox[{"[", "2", "]"}], "]"}], "/", 
     RowBox[{
      RowBox[{"(", "d\[Tau]", ")"}], "^", "2"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"c", "^", "2"}], "==", 
     RowBox[{"%", "[", 
      RowBox[{"[", "2", "]"}], "]"}]}], "/.", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"dx", "[", "i_", "]"}], "^", "2"}], "/", 
      RowBox[{"d\[Tau]", "^", "2"}]}], "->", 
     RowBox[{
      RowBox[{"IndexDerivative", "[", 
       RowBox[{
        RowBox[{"x", "[", "i", "]"}], ",", "\[Tau]"}], "]"}], "^", "2"}]}]}], 
   "//", "Simplify"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"%", "/.", 
      RowBox[{
       RowBox[{"x", "[", "3", "]"}], "->", 
       RowBox[{"Pi", "/", "2"}]}]}], "/.", 
     RowBox[{"s3", "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], "/.", 
    RowBox[{"s4", "[", 
     RowBox[{"[", "1", "]"}], "]"}]}], "//", "Simplify"}], "//", "Expand"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Solve", "[", 
   RowBox[{"%", ",", 
    RowBox[{
     StyleBox["IndexDerivative",
      FontColor->GrayLevel[0]], "[", 
     RowBox[{
      RowBox[{"x", "[", "2", "]"}], ",", "\[Tau]"}], "]"}]}], "]"}], "//", 
  "Expand"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"IndexDerivative", "[", 
    RowBox[{
     RowBox[{"x", "[", "2", "]"}], ",", "\[Tau]"}], "]"}], "^", "2"}], "==", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"IndexDerivative", "[", 
        RowBox[{
         RowBox[{"x", "[", "2", "]"}], ",", "\[Tau]"}], "]"}], "^", "2"}], "/.", 
      RowBox[{"%", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], "//", "Expand"}], "//", "Simplify"}],
    ")"}]}], "\[IndentingNewLine]", 
 RowBox[{"s4", "=", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"1", "/", "2"}], 
     RowBox[{"%", "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", "1"}], "]"}], "]"}]}], "-", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"%", "[", 
        RowBox[{"[", 
         RowBox[{"2", ",", 
          RowBox[{"2", ";;", "4"}]}], "]"}], "]"}], "/", "2"}], "//", 
      "Expand"}], ")"}]}], "==", 
   RowBox[{
    RowBox[{"%", "[", 
     RowBox[{"[", 
      RowBox[{"2", ",", "1"}], "]"}], "]"}], "/", 
    "2"}]}]}], "\[IndentingNewLine]", "\"\<If we denote the first term by T, \
the second to fourth terms by effective potential:V[x[2]], and the right-hand \
side by E, this has the form of the law of conservation of energy in \
classical mechanics, T + V = E. Note that the fourth term of V(r), \[Minus]a \
c^2/(2x[2]), is the term for the gravitational field \[Minus]GM/r.\>\""}], \
"Input",
 CellChangeTimes->{{3.9440276944163237`*^9, 3.9440276959131327`*^9}, {
  3.944096008418231*^9, 3.944096025077684*^9}, {3.944096099435144*^9, 
