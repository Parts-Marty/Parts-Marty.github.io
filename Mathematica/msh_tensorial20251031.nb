Roman\",FontSize->16,FontSlant->Italic,FontColor->GrayLevel[0]]\) in terms of \
potential\>\"", "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Tensor", "[", 
   RowBox[{"F", ",", 
    RowBox[{"{", 
     RowBox[{"Void", ",", "Void"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"m", ",", "n"}], "}"}]}], "]"}], "==", 
  RowBox[{
   RowBox[{"IndexUpDeri", "[", 
    RowBox[{"m", ",", 
     RowBox[{"Tensor", "[", 
      RowBox[{"A", ",", 
       RowBox[{"{", "Void", "}"}], ",", 
       RowBox[{"{", "n", "}"}]}], "]"}]}], "]"}], "-", 
