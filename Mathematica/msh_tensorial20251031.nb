     RowBox[{"Tensor", "[", 
      RowBox[{"A", ",", 
       RowBox[{"{", "Void", "}"}], ",", 
       RowBox[{"{", "m", "}"}]}], "]"}]}], "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"IndexDerivative", "[", 
    RowBox[{
     RowBox[{"%", "[", 
      RowBox[{"[", "2", "]"}], "]"}], ",", 
