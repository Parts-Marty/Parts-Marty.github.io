  FormBox[
   StyleBox[
    SubscriptBox["A", "1"],
    FontColor->GrayLevel[0]], TraditionalForm]],ExpressionUUID->
  "1ddf1b59-8c07-4394-8bbf-01a8b6220a38"],
 StyleBox["=-\[Phi]/c,  (6)E=-\[Del]\[Phi]-\[PartialD]A/\[PartialD]t,  (7)B=\
\[Del]\[Cross]A",
