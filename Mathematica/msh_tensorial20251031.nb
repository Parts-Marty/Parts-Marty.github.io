      RowBox[{"{", "m", "}"}]}], "]"}]}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", "\"\<From (1) to the \
following formula(2)\>\"", "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"IndexUpDeri", "[", 
     RowBox[{"m", ",", 
      RowBox[{"IndexDerivative", "[", 
       RowBox[{
        RowBox[{"Tensor", "[", 
         RowBox[{"A", ",", 
          RowBox[{"{", "Void", "}"}], ",", 
          RowBox[{"{", "n", "}"}]}], "]"}], ",", 
        RowBox[{"x", "[", "n", "]"}]}], "]"}]}], "]"}], "-", 
    RowBox[{"IndexUpDeri", "[", 
     RowBox[{"n", ",", 
      RowBox[{"IndexDerivative", "[", 
       RowBox[{
        RowBox[{"Tensor", "[", 
         RowBox[{"A", ",", 
          RowBox[{"{", "Void", "}"}], ",", 
          RowBox[{"{", "m", "}"}]}], "]"}], ",", 
        RowBox[{"x", "[", "n", "]"}]}], "]"}]}], "]"}]}], "==", 
   RowBox[{"\[Mu]0", " ", 
    RowBox[{"Tensor", "[", 
     RowBox[{"J", ",", 
      RowBox[{"{", "Void", "}"}], ",", 
      RowBox[{"{", "m", "}"}]}], "]"}]}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", "\"\<The following formula \
is Lorentz condition\>\"", "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"IndexDerivative", "[", 
    RowBox[{
     RowBox[{"Tensor", "[", 
      RowBox[{"A", ",", 
       RowBox[{"{", "Void", "}"}], ",", 
       RowBox[{"{", "n", "}"}]}], "]"}], ",", 
     RowBox[{"x", "[", "n", "]"}]}], "]"}], "==", "0"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", "\"\<In other words:1/c^2 \
\[PartialD]\[Phi]/\[PartialD]t+\[Del].A=0\>\"", "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ExpandDoubleIndex", "[", 
    RowBox[{
     RowBox[{"%%", "[", 
      RowBox[{"[", "1", "]"}], "]"}], ",", 
     RowBox[{"{", "n", "}"}]}], "]"}], "==", "0"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", "\"\<From (2) to Potential \
wave equation(3) by Lorentz condition\>\"", "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"IndexUpDeri", "[", 
   RowBox[{"n", ",", 
    RowBox[{"IndexDerivative", "[", 
     RowBox[{
      RowBox[{"Tensor", "[", 
       RowBox[{"A", ",", 
        RowBox[{"{", "Void", "}"}], ",", 
        RowBox[{"{", "m", "}"}]}], "]"}], ",", 
      RowBox[{"x", "[", "n", "]"}]}], "]"}]}], "]"}], "==", 
  RowBox[{
   RowBox[{"-", "\[Mu]0"}], " ", 
