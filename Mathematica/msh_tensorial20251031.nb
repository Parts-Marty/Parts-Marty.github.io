Cell[CellGroupData[{

Cell["\<\
By solving this differential equation, we can obtain the geodesic. First, \
multiply the equation below by A, and rewrite it as follows.\
\>", "Subsubsection",
 CellChangeTimes->{
  3.941243517215123*^9, {3.943036765364875*^9, 3.9430367734491777`*^9}, {
