  Background->GrayLevel[0.85]], "\[IndentingNewLine]", 
 StyleBox[
  RowBox[{
   RowBox[{"Evaluate", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"%%%", "[", 
       RowBox[{"[", "2", "]"}], "]"}], "/.", 
      RowBox[{
       RowBox[{"x", "[", "2", "]"}], "->", 
       RowBox[{"r", " ", "a"}]}]}], "/.", 
     RowBox[{"h", "->", 
      RowBox[{"L", " ", "a", " ", "c"}]}]}], "]"}], ";"}],
  Background->GrayLevel[0.85]], "\[IndentingNewLine]", 
 StyleBox[
  RowBox[{
   RowBox[{"Vv", "[", "r_", "]"}], "=", "%"}],
  Background->GrayLevel[0.85]], "\[IndentingNewLine]", 
 StyleBox["\"\<Vr[r]:Effective potential of general relativity by \
r=x[2]/a\>\"",
