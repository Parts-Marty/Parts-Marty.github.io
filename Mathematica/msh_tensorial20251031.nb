Cell[BoxData[{
 RowBox[{"Remove", "[", "\"\<Global`*\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"GM", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"x", "[", "2", "]"}], ",", "0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", 
       RowBox[{
        RowBox[{"x", "[", "3", "]"}], 
        RowBox[{"x", "[", "2", "]"}], 
        RowBox[{"x", "[", "1", "]"}]}], ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", 
       RowBox[{"Sin", "[", 
        RowBox[{"x", "[", "1", "]"}], "]"}]}], "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SetSystem", "[", 
   RowBox[{"x", ",", "g", ",", "GM"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Christoffel1", "[", 
    RowBox[{"g", ",", "x"}], "]"}], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"3", ",", "3"}], "}"}], ",", 
    RowBox[{"{", "1", "}"}]}], "]"}], " "}], "\[IndentingNewLine]", 
 RowBox[{"EvaluateIndexDerivative", "[", "%", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Christoffel2", "[", 
    RowBox[{"g", ",", "x"}], "]"}], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"2", ",", "1"}], "}"}], ",", 
    RowBox[{"{", "2", "}"}]}], "]"}], " "}], "\n", 
 RowBox[{"EvaluateIndexDerivative", "[", "%", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ExpandIndex", "[", "\n", "\t", 
    RowBox[{
     RowBox[{
      RowBox[{"Christoffel1", "[", 
       RowBox[{"g", ",", "x"}], "]"}], "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"i", ",", "j"}], "}"}], ",", 
       RowBox[{"{", "k", "}"}]}], "]"}], "\n", ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "i", ",", "j"}], "}"}]}], "]"}], "//", 
   "EvaluateIndexDerivative"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Map", "[", 
  RowBox[{"MatrixForm", ",", "%"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ExpandIndex", "[", "\n", "\t", 
   RowBox[{
    RowBox[{
     RowBox[{"Christoffel2", "[", 
      RowBox[{"g", ",", "x"}], "]"}], "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"i", ",", "j"}], "}"}], ",", 
      RowBox[{"{", "k", "}"}]}], "]"}], "\n", ",", 
    RowBox[{"{", 
     RowBox[{"k", ",", "i", ",", "j"}], "}"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ss", "=", 
   RowBox[{"%", "//", "EvaluateIndexDerivative"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Map", "[", 
  RowBox[{"MatrixForm", ",", "%"}], "]"}], "\[IndentingNewLine]", 
