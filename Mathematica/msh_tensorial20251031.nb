Cell[CellGroupData[{

Cell["3.1.Partial Derivative", "Section",
 CellChangeTimes->{{3.929044669453943*^9, 3.9290446734305153`*^9}, {
  3.96939655969223*^9, 3.969396565571253*^9}},
 Background->GrayLevel[
  0.900008],ExpressionUUID->"1674e296-cfe5-481d-b435-10da2a96a1b9"],

Cell[CellGroupData[{

Cell["\<\
Taking Derivatives is very important, so we defined a differential operator \
called IndexDerivative, which behaves in many ways like the normal Derivative \
\"D\", but with important specific Characteristics as we'll see below.
As an example of IndexDerivative we define a Tensor A with particular values.\
\>", "Subsubsection",
 CellChangeTimes->{
  3.915646766746097*^9, {3.9156487059248543`*^9, 3.915648720947587*^9}, {
   3.9290437994465775`*^9, 3.929043800741375*^9}},
 Background->RGBColor[
  0.88, 1, 0.88],ExpressionUUID->"5396fae7-bcad-488f-b2de-6e8bb15a9cb3"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Remove", "[", "\"\<Global`*\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"NDim", "=", "3"}], ";"}], "\n", 
 RowBox[{"TA", " ", "=", " ", 
  RowBox[{"Tensor", "[", 
   RowBox[{"A", ",", 
    RowBox[{"{", "Void", "}"}], ",", 
    RowBox[{"{", "j", "}"}]}], "]"}]}], "\n", 
 RowBox[{
  RowBox[{"ValuesTA", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", " ", 
      RowBox[{"x", "[", "1", "]"}]}], ",", 
     RowBox[{"b", " ", 
      RowBox[{"x", "[", "2", "]"}]}], ",", 
     RowBox[{"c", " ", 
      RowBox[{"x", "[", "3", "]"}]}]}], "}"}]}], ";"}], "\n", 
 RowBox[{"Do", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Tensor", "[", 
      RowBox[{"A", ",", 
       RowBox[{"{", "Void", "}"}], ",", 
       RowBox[{"{", "i", "}"}]}], "]"}], " ", "=", " ", 
     RowBox[{"ValuesTA", "[", 
      RowBox[{"[", "i", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", ",", 
   RowBox[{"{", 
    RowBox[{"i", ",", "1", ",", "3"}], "}"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ExpandIndex", "[", 
   RowBox[{"TA", ",", 
    RowBox[{"{", "j", "}"}]}], "]"}], " "}]}], "Input",
