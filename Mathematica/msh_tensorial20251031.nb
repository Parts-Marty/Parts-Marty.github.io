Cell[CellGroupData[{

Cell["\<\
The equation we are looking for is called the law of conservation of areas \
with respect to \[Tau] (law of conservation of angular momentum). \
\[OpenCurlyDoubleQuote]h\[CloseCurlyDoubleQuote] is the angular velocity.\
\>", "Subsubsection",
 CellChangeTimes->{{3.9421041807837024`*^9, 3.942104266267609*^9}, {
  3.9421042969117565`*^9, 3.942104329688819*^9}, {3.942105001784143*^9, 
