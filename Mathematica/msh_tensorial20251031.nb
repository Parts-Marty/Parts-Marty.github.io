Cell[CellGroupData[{

Cell["\<\
To expand tensors with double indexes we have to use explicitly the command \
ExpandDoubleIndex[ Tensor , double index ] . In this case double indexes are \
treated as dummy variables.\
\>", "Subsubsection",
 CellChangeTimes->{3.915428215433031*^9, 3.915428393802902*^9},
 Background->RGBColor[
  0.88, 1, 0.88],ExpressionUUID->"f2cd4cec-c686-4cae-bff7-d5ee10df2d70"],

