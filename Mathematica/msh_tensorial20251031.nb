Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Remove", "[", "\"\<Global`*\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"a", "=", "3"}], ";", 
  RowBox[{"b", "=", "2"}], ";", 
  RowBox[{"c", "=", "1"}], 
  ";"}], "\[IndentingNewLine]", "\"\< in spherical coordinates\>\"", "\[IndentingNewLine]", 
 RowBox[{"r2", "=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"x", "[", "1", "]"}], "->", 
     RowBox[{"a", " ", 
      RowBox[{"Sec", "[", "t", "]"}]}]}], ",", 
    RowBox[{
     RowBox[{"x", "[", "2", "]"}], "->", 
     RowBox[{"t", "+", "b"}]}], ",", 
    RowBox[{
     RowBox[{"x", "[", "3", "]"}], "->", "c"}]}], 
   "}"}]}], "\[IndentingNewLine]", "\"\< in Cartesian coordinates\>\"", "\[IndentingNewLine]", 
 RowBox[{"r3", "=", 
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"x", "[", "1", "]"}], 
       RowBox[{"Sin", "[", 
        RowBox[{"x", "[", "2", "]"}], "]"}], 
       RowBox[{"Cos", "[", 
        RowBox[{"x", "[", "3", "]"}], "]"}]}], ",", 
      RowBox[{
       RowBox[{"x", "[", "1", "]"}], 
       RowBox[{"Sin", "[", 
        RowBox[{"x", "[", "2", "]"}], "]"}], 
       RowBox[{"Sin", "[", 
        RowBox[{"x", "[", "3", "]"}], "]"}]}], ",", 
      RowBox[{
       RowBox[{"x", "[", "1", "]"}], 
       RowBox[{"Cos", "[", 
        RowBox[{"x", "[", "2", "]"}], "]"}]}]}], "}"}], "/.", "r2"}], "//", 
   "Simplify"}]}], "\[IndentingNewLine]", 
 RowBox[{"ParametricPlot3D", "[", 
  RowBox[{"r3", ",", 
