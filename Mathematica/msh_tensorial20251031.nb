Roman\",FontSize->16,FontSlant->Italic,FontColor->GrayLevel[0]]\)]==effect of \
general relativity+centrifugal potential+Newtonian potential\>\"",
  Background->GrayLevel[0.85]], "\[IndentingNewLine]", 
 StyleBox[
  RowBox[{
   RowBox[{
    RowBox[{"V", "[", 
     RowBox[{"x", "[", "2", "]"}], "]"}], "==", 
    RowBox[{
     RowBox[{"s4", "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", 
        RowBox[{"2", ";;", "4"}]}], "]"}], "]"}], "/", 
     RowBox[{"c", "^", "2"}]}]}], "//", "Expand"}],
  Background->GrayLevel[0.85]], "\[IndentingNewLine]", 
 RowBox[{"r", "==", 
  RowBox[{
   RowBox[{"x", "[", "2", "]"}], "/", "a"}]}], "\[IndentingNewLine]", 
 StyleBox[
  RowBox[{"L", "==", 
   RowBox[{"h", "/", 
    RowBox[{"(", 
