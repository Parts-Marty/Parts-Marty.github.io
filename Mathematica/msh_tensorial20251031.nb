       RowBox[{"{", "Void", "}"}], ",", 
       RowBox[{"{", "\[Phi]", "}"}]}], "]"}]}], ",", "s"}], "]"}], "==", 
  "0"}], "\[IndentingNewLine]", 
 RowBox[{
