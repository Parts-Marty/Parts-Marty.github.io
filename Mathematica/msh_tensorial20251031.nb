Cell[CellGroupData[{

Cell["\<\
A second-order tensor T defines a linear transformation that maps a vector u \
to a new vector T(u).  T[u]==(Aa\[CircleTimes]Bb)[u]==(u.Bb)Aa
A second-order tensor T acts on two vectors u and v to produce a scalar T(u, \
v).
T[u,v]==(Aa\[CircleTimes]Bb)[u,v]==(Aa.v)(Bb.u)\
\>", "Subsubsection",
 CellChangeTimes->{
  3.915428215433031*^9, 3.915428393802902*^9, {3.9419470260556936`*^9, 
   3.941947036000718*^9}, {3.9419475740644884`*^9, 3.9419475875934334`*^9}, {
   3.943385233610409*^9, 3.9433852507311068`*^9}, {3.9433860579694943`*^9, 
   3.9433860726019993`*^9}, {3.943387943576025*^9, 3.9433879530087023`*^9}, {
   3.9680516458875465`*^9, 3.968051658815684*^9}, {3.9680518360797863`*^9, 
   3.9680518369921684`*^9}, {3.9680520516170797`*^9, 3.968052055537509*^9}, {
   3.968052324443555*^9, 3.968052330994438*^9}, {3.9680523805980453`*^9, 
   3.9680523895402336`*^9}, {3.9680526186928697`*^9, 3.968052728621705*^9}, {
   3.968052960062828*^9, 3.968052968807021*^9}},
 Background->RGBColor[
  0.88, 1, 0.88],ExpressionUUID->"29377304-d191-4d3d-8951-c5fa881d5d59"],

