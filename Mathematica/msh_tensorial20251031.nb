  0.88, 1, 0.88],ExpressionUUID->"4284721a-d5ba-2f41-9bdc-6e87c330651e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"1.", " ", "-", 
    RowBox[{
    "Definition", " ", "of", " ", "the", " ", "toroidal", " ", "domain"}]}], 
   "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"R", "=", "3"}], ";", 
    RowBox[{"r", "=", "1"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"torusRegion", "=", 
     RowBox[{"ParametricRegion", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"R", "+", 
            RowBox[{"r", " ", 
             RowBox[{"Cos", "[", "v", "]"}]}]}], ")"}], " ", 
          RowBox[{"Cos", "[", "u", "]"}]}], ",", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"R", "+", 
            RowBox[{"r", " ", 
             RowBox[{"Cos", "[", "v", "]"}]}]}], ")"}], " ", 
          RowBox[{"Sin", "[", "u", "]"}]}], ",", 
         RowBox[{"r", " ", 
          RowBox[{"Sin", "[", "v", "]"}]}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"u", ",", "0", ",", 
           RowBox[{"2", " ", "Pi"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"v", ",", "0", ",", 
           RowBox[{"2", " ", "Pi"}]}], "}"}]}], "}"}]}], "]"}]}], ";"}], "\n",
    "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "2.", " ", "Definition", " ", "of", " ", "the", " ", "start", " ", "and", 
     " ", "end", " ", "points"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"p1", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"R", "+", "r"}], ",", "0", ",", "0"}], "}"}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"Points", " ", "on", " ", "the", " ", "outer", " ", "perimeter"}],
     "*)"}], "\n", 
   RowBox[{
    RowBox[{"p2", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "R"}], "-", "r"}], ",", "0", ",", "0"}], "}"}]}], ";"}], 
   " ", 
   RowBox[{"(*", 
    RowBox[{
    "Farthest", " ", "point", " ", "on", " ", "the", " ", "outer", " ", 
     "perimeter"}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "3.", " ", "Computation", " ", "of", " ", "the", " ", "shortest", " ", 
     "path", " ", 
     RowBox[{"(", 
      RowBox[{
      "requires", " ", "version", " ", "14.3", " ", "or", " ", "later"}], 
      ")"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"shortestPath", "=", 
     RowBox[{"FindShortestCurve", "[", 
      RowBox[{"torusRegion", ",", "p1", ",", "p2", ",", 
       RowBox[{"WorkingPrecision", "\[Rule]", "Automatic"}]}], "]"}]}], ";"}],
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "4.", " ", "Calculation", " ", "of", " ", "the", " ", "shortest", " ", 
     "distance"}], "*)"}], "\n", 
   RowBox[{"shortestDistance", "=", 
    RowBox[{"ShortestCurveDistance", "[", 
     RowBox[{"torusRegion", ",", "p1", ",", "p2"}], "]"}]}]}]}]], "Input",
 CellChangeTimes->{{3.9701735433275127`*^9, 3.970173596472801*^9}, {
   3.9701736595593643`*^9, 3.970173746586529*^9}, 3.9701738822289677`*^9, 
   3.970174306984144*^9, 3.970174352205*^9, {3.970174399905596*^9, 
   3.9701744370683117`*^9}, {3.9701745281064644`*^9, 3.970174639433529*^9}, 
   3.9701821083829975`*^9},
