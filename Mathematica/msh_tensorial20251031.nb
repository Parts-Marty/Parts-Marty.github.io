Cell[TextData[{
 "Assuming spherical symmetry,the metric tensor is generally given the \
flowing.\n",
 Cell[BoxData[
  TagBox[
   RowBox[{"(", "\[NoBreak]", GridBox[{
      {
       RowBox[{"-", 
        StyleBox[
         TemplateBox[{
           InterpretationBox[
            
            RowBox[{"\"(\"", "\[InvisibleSpace]", "\[ExponentialE]", 
              "\[InvisibleSpace]", "\")\""}], 
            SequenceForm["(", E, ")"], Editable -> False], 
           RowBox[{"\[Nu]", "[", 
             StyleBox[
              TemplateBox[{"x", 
                InterpretationBox["\"  \"", 
                 SequenceForm["  "], Editable -> False], 
                InterpretationBox["2", 
                 SequenceForm[2], Editable -> False]}, "Subsuperscript", 
               SyntaxForm -> SubsuperscriptBox], 
              GrayLevel[0], Italic, 16, FontFamily -> "Times New Roman", 
              StripOnInput -> False], "]"}]},
          "Superscript"],
         StripOnInput->False,
         LineColor->GrayLevel[0],
         FrontFaceColor->GrayLevel[0],
         BackFaceColor->GrayLevel[0],
         GraphicsColor->GrayLevel[0],
         FontFamily->"Times New Roman",
         FontSize->14,
         FontWeight->Plain,
         FontSlant->Plain,
         FontVariations->{"StrikeThrough"->False,
         "Underline"->False},
         FontColor->GrayLevel[0]]}], "0", "0", "0"},
      {"0", 
       StyleBox[
        TemplateBox[{
          InterpretationBox[
           
           RowBox[{"\"(\"", "\[InvisibleSpace]", "\[ExponentialE]", 
             "\[InvisibleSpace]", "\")\""}], 
           SequenceForm["(", E, ")"], Editable -> False], 
          RowBox[{"\[Lambda]", "[", 
            StyleBox[
             TemplateBox[{"x", 
               InterpretationBox["\"  \"", 
                SequenceForm["  "], Editable -> False], 
               InterpretationBox["2", 
                SequenceForm[2], Editable -> False]}, "Subsuperscript", 
              SyntaxForm -> SubsuperscriptBox], 
             GrayLevel[0], Italic, 16, FontFamily -> "Times New Roman", 
             StripOnInput -> False], "]"}]},
         "Superscript"],
        StripOnInput->False,
        LineColor->GrayLevel[0],
        FrontFaceColor->GrayLevel[0],
        BackFaceColor->GrayLevel[0],
        GraphicsColor->GrayLevel[0],
        FontFamily->"Times New Roman",
        FontSize->14,
        FontWeight->Plain,
        FontSlant->Plain,
        FontVariations->{"StrikeThrough"->False,
        "Underline"->False},
        FontColor->GrayLevel[0]], "0", "0"},
      {"0", "0", 
       StyleBox[
        TemplateBox[{
          InterpretationBox[
           RowBox[{"\"(\"", "\[InvisibleSpace]", 
             StyleBox[
              TemplateBox[{"x", 
                InterpretationBox["\"  \"", 
                 SequenceForm["  "], Editable -> False], 
                InterpretationBox["2", 
                 SequenceForm[2], Editable -> False]}, "Subsuperscript", 
               SyntaxForm -> SubsuperscriptBox], 
              GrayLevel[0], Italic, 16, FontFamily -> "Times New Roman", 
              StripOnInput -> False], "\[InvisibleSpace]", "\")\""}], 
           SequenceForm["(", 
            mshtensorial`Tensor[mshtensorial`x, {"  "}, {2}], ")"], Editable -> 
           False], "2"},
         "Superscript"],
        StripOnInput->False,
        LineColor->GrayLevel[0],
        FrontFaceColor->GrayLevel[0],
        BackFaceColor->GrayLevel[0],
        GraphicsColor->GrayLevel[0],
        FontFamily->"Times New Roman",
        FontSize->14,
        FontWeight->Plain,
        FontSlant->Plain,
        FontVariations->{"StrikeThrough"->False,
        "Underline"->False},
        FontColor->GrayLevel[0]], "0"},
      {"0", "0", "0", 
       RowBox[{
        StyleBox[
         TemplateBox[{
           InterpretationBox[
            RowBox[{"\"(\"", "\[InvisibleSpace]", 
              RowBox[{"Sin", "[", 
                StyleBox[
                 TemplateBox[{"x", 
                   InterpretationBox["\"  \"", 
                    SequenceForm["  "], Editable -> False], 
                   InterpretationBox["3", 
                    SequenceForm[3], Editable -> False]}, "Subsuperscript", 
                  SyntaxForm -> SubsuperscriptBox], 
                 GrayLevel[0], Italic, 16, FontFamily -> "Times New Roman", 
                 StripOnInput -> False], "]"}], "\[InvisibleSpace]", 
              "\")\""}], 
            SequenceForm["(", 
             Sin[
              mshtensorial`Tensor[mshtensorial`x, {"  "}, {3}]], ")"], 
            Editable -> False], "2"},
          "Superscript"],
         StripOnInput->False,
         LineColor->GrayLevel[0],
         FrontFaceColor->GrayLevel[0],
         BackFaceColor->GrayLevel[0],
         GraphicsColor->GrayLevel[0],
         FontFamily->"Times New Roman",
         FontSize->14,
         FontWeight->Plain,
         FontSlant->Plain,
         FontVariations->{"StrikeThrough"->False,
         "Underline"->False},
         FontColor->GrayLevel[0]], " ", 
        StyleBox[
         TemplateBox[{
