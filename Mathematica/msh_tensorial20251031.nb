Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Remove", "[", "\"\<Global`*\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ds", "^", "2"}], "==", 
  RowBox[{
   RowBox[{"-", 
    RowBox[{"dct", "^", "2"}]}], "+", 
   RowBox[{"dr", "^", "2"}], "+", 
   RowBox[{"d\[Theta]", "^", "2"}], "+", 
   RowBox[{"d\[Phi]", "^", "2"}]}], "==", 
  RowBox[{
   RowBox[{"-", 
    RowBox[{
     RowBox[{"dx", "[", "1", "]"}], "^", "2"}]}], "+", 
   RowBox[{
    RowBox[{"dx", "[", "2", "]"}], "^", "2"}], "+", 
   RowBox[{
    RowBox[{"dx", "[", "3", "]"}], "^", "2"}], "+", 
   RowBox[{
    RowBox[{"dx", "[", "4", "]"}], "^", "2"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"NDim", "=", "4"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"GMs", "=", 
   RowBox[{"DiagonalMatrix", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{"a", "/", 
          RowBox[{"x", "[", "2", "]"}]}]}], ")"}]}], ",", 
      RowBox[{"1", "/", 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{"a", "/", 
          RowBox[{"x", "[", "2", "]"}]}]}], ")"}]}], ",", 
      RowBox[{
       RowBox[{"x", "[", "2", "]"}], "^", "2"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"x", "[", "2", "]"}], "^", "2"}], " ", 
       RowBox[{
        RowBox[{"Sin", "[", 
         RowBox[{"x", "[", "3", "]"}], "]"}], "^", "2"}]}]}], "}"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"MatrixForm", "[", "%", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"GM", "=", 
   RowBox[{"DiagonalMatrix", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"Exp", "[", 
        RowBox[{"\[Nu]", "[", 
         RowBox[{"x", "[", "2", "]"}], "]"}], "]"}]}], ",", 
      RowBox[{"Exp", "[", 
       RowBox[{"\[Lambda]", "[", 
        RowBox[{"x", "[", "2", "]"}], "]"}], "]"}], ",", 
      RowBox[{
       RowBox[{"x", "[", "2", "]"}], "^", "2"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"x", "[", "2", "]"}], "^", "2"}], " ", 
       RowBox[{
        RowBox[{"Sin", "[", 
         RowBox[{"x", "[", "3", "]"}], "]"}], "^", "2"}]}]}], "}"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"MatrixForm", "[", "%", "]"}], 
  ";"}], "\[IndentingNewLine]", "\"\<Assuming spherical symmetry,the metric \
tensor is generally given by the following formula\>\"", "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Tensor", "[", 
   RowBox[{"g", ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "j"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"Void", ",", "Void"}], "}"}]}], "]"}], "==", 
  RowBox[{"MatrixForm", "[", "GM", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"SetSystem", "[", 
  RowBox[{"x", ",", "g", ",", "GM"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Christoffel2", "[", 
    RowBox[{"g", ",", "x"}], "]"}], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"j", ",", "k"}], "}"}], ",", 
    RowBox[{"{", "i", "}"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ExpandIndex", "[", 
   RowBox[{"%", ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "j", ",", "k"}], "}"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"EvaluateIndexDerivative", "[", "%", "]"}], "//", "Simplify"}], 
