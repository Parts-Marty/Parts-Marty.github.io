Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Remove", "[", "\"\<Global`*\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{"GM", "=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"x", "[", "2", "]"}], "^", 
       RowBox[{"(", 
        RowBox[{"-", "2"}], ")"}]}], ",", "0", ",", "0"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"0", ",", 
      RowBox[{
       RowBox[{"x", "[", "2", "]"}], "^", 
       RowBox[{"(", 
        RowBox[{"-", "2"}], ")"}]}], ",", "0"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"0", ",", "0", ",", 
      RowBox[{
       RowBox[{"x", "[", "2", "]"}], "^", 
       RowBox[{"(", 
        RowBox[{"-", "2"}], ")"}]}]}], "}"}]}], "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SetSystem", "[", 
   RowBox[{"x", ",", "g", ",", "GM"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"gDet", "=", 
   RowBox[{"Det", "[", 
    RowBox[{"ExpandIndex", "[", 
     RowBox[{
      RowBox[{"Tensor", "[", 
       RowBox[{"g", ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "j"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"Void", ",", "Void"}], "}"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "j"}], "}"}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Tensor", "[", 
   RowBox[{"R", ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "j"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"Void", ",", "Void"}], "}"}]}], "]"}], "==", 
  RowBox[{"Tensor", "[", 
   RowBox[{"R", ",", 
    RowBox[{"{", 
     RowBox[{"j", ",", "i"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"Void", ",", "Void"}], "}"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Tensor", "[", 
   RowBox[{"R", ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "j"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"Void", ",", "Void"}], "}"}]}], "]"}], "==", 
  RowBox[{"-", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"IndexDerivative", "[", 
      RowBox[{
       RowBox[{"Log", "[", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"Abs", "[", "gDet", "]"}], "]"}], "]"}], ",", 
       RowBox[{"x", "[", "i", "]"}], ",", 
       RowBox[{"x", "[", "j", "]"}]}], "]"}], "-", 
     RowBox[{
      RowBox[{"1", "/", 
       RowBox[{"Sqrt", "[", 
        RowBox[{"Abs", "[", "gDet", "]"}], "]"}]}], 
      RowBox[{"IndexDerivative", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Sqrt", "[", 
          RowBox[{"Abs", "[", "gDet", "]"}], "]"}], " ", 
         RowBox[{
          RowBox[{"Christoffel2", "[", 
           RowBox[{"g", ",", "x"}], "]"}], "[", 
          RowBox[{
           RowBox[{"{", 
