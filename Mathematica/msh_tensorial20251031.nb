Cell[CellGroupData[{

Cell[TextData[StyleBox["3.Derivative of Tensor",
 FontSize->36,
 FontColor->RGBColor[0, 0, 1]]], "Chapter",
 CellChangeTimes->{{3.9290489197496643`*^9, 3.9290489227173243`*^9}, {
