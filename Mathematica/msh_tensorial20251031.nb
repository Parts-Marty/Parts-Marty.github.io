Cell[BoxData[{
 RowBox[{
  RowBox[{"Remove", "[", "\"\<Global`*\>\"", "]"}], "\n", 
  RowBox[{"(*", 
   RowBox[{"1.", " ", "-", 
    RowBox[{
    "Definition", " ", "of", " ", "the", " ", "toroidal", " ", "domain"}]}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"a", "=", 
    RowBox[{"1", "/", "3"}]}], ";", 
   RowBox[{"b", "=", 
    RowBox[{"1", "/", "5"}]}], ";", 
   RowBox[{"c", "=", 
    RowBox[{"1", "/", "3"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"torusRegion", "=", 
    RowBox[{"ParametricRegion", "[", 
     RowBox[{
      RowBox[{"{", " ", 
       RowBox[{
        RowBox[{"a", "   ", 
         RowBox[{"Cosh", "[", "u", "]"}], 
         RowBox[{"Cos", "[", "v", "]"}]}], ",", 
        RowBox[{"b", "  ", 
         RowBox[{"Cosh", "[", "u", "]"}], 
         RowBox[{"Sin", "[", "v", "]"}]}], ",", 
        RowBox[{"c", " ", 
         RowBox[{"Sinh", "[", "u", "]"}]}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"u", ",", 
          RowBox[{"-", " ", "Pi"}], ",", " ", "Pi"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"v", ",", " ", "0", ",", " ", 
          RowBox[{"2", " ", "Pi"}]}], "}"}]}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "2.", " ", "Definition", " ", "of", " ", "the", " ", "start", " ", "and", " ",
     "end", " ", "points"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"p1", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"{", " ", 
      RowBox[{
       RowBox[{"a", " ", 
        RowBox[{"Cosh", "[", "u", "]"}], 
        RowBox[{"Cos", "[", "v", "]"}]}], ",", 
       RowBox[{"b", " ", 
        RowBox[{"Cosh", "[", "u", "]"}], 
        RowBox[{"Sin", "[", "v", "]"}]}], ",", 
       RowBox[{"c", " ", 
        RowBox[{"Sinh", "[", "u", "]"}]}]}], "}"}], "/.", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"u", "->", 
        RowBox[{
         RowBox[{"-", "Pi"}], " ", 
         RowBox[{"80", "/", "100"}]}]}], ",", 
       RowBox[{"v", "->", "0"}]}], "}"}]}], " ", "//", "N"}]}], 
  RowBox[{"(*", 
   RowBox[{"Points", " ", "on", " ", "the", " ", "outer", " ", "perimeter"}], 
   "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"p2", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"{", " ", 
      RowBox[{
       RowBox[{"a", " ", 
        RowBox[{"Cosh", "[", "u", "]"}], 
        RowBox[{"Cos", "[", "v", "]"}]}], ",", 
       RowBox[{"b", " ", 
        RowBox[{"Cosh", "[", "u", "]"}], 
        RowBox[{"Sin", "[", "v", "]"}]}], ",", 
       RowBox[{"c", " ", 
        RowBox[{"Sinh", "[", "u", "]"}]}]}], "}"}], "/.", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"u", "->", 
        RowBox[{"Pi", "  ", 
         RowBox[{"80", "/", "100"}]}]}], ",", 
       RowBox[{"v", "->", " ", 
        RowBox[{"Pi", "/", "2"}]}]}], "}"}]}], " ", "//", "N"}]}], 
  RowBox[{"(*", 
   RowBox[{
   "Farthest", " ", "point", " ", "on", " ", "the", " ", "outer", " ", 
    "perimeter"}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "3.", " ", "Computation", " ", "of", " ", "the", " ", "shortest", " ", 
    "path", " ", 
    RowBox[{"(", 
     RowBox[{
     "requires", " ", "version", " ", "14.3", " ", "or", " ", "later"}], 
     ")"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"shortestPath", "=", 
   RowBox[{"FindShortestCurve", "[", 
    RowBox[{"torusRegion", ",", "p1", ",", "p2", ",", 
     RowBox[{"WorkingPrecision", "\[Rule]", "Automatic"}]}], "]"}]}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "4.", " ", "Calculation", " ", "of", " ", "the", " ", "shortest", " ", 
    "distance"}], "*)"}]}], "\n", 
 RowBox[{"shortestDistance", "=", 
  RowBox[{"ShortestCurveDistance", "[", 
   RowBox[{"torusRegion", ",", "p1", ",", "p2"}], "]"}]}]}], "Input",
