Cell[CellGroupData[{

Cell["\<\
Let\[CloseCurlyQuote]s consider the great circles X = a cos[(s \[Minus]s0)/a] \
and Y = a sin[(s \[Minus]s0)/a] placed on the XY plane and tilt them 
by \[Minus]\[Theta]0 around the Y axis.\
\>", "Subsubsection",
 CellChangeTimes->{{3.9422078415020733`*^9, 3.9422078613339477`*^9}, {
