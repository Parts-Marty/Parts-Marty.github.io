Cell[CellGroupData[{

Cell["Tangent  and Normal vector on a manifold by ParametricPlot3D", \
"Subsubsection",
 CellChangeTimes->{{3.941572305568369*^9, 3.941572313091811*^9}, {
   3.941572671371856*^9, 3.941572677276538*^9}, {3.941573623876234*^9, 
   3.9415737101948805`*^9}, {3.9415782546539917`*^9, 3.941578263089117*^9}, {
   3.941612603536679*^9, 3.941612604607336*^9}, {3.9416130139019704`*^9, 
   3.9416130163499193`*^9}, {3.9416131231253705`*^9, 3.94161318388196*^9}, {
   3.9416132618044233`*^9, 3.941613316585831*^9}, {3.9416136305696173`*^9, 
   3.9416136497515893`*^9}, {3.9416137158141117`*^9, 
   3.9416137221482215`*^9}, {3.941649394890124*^9, 3.941649396201136*^9}, {
   3.9416504915234365`*^9, 3.941650538363735*^9}, {3.941652474636074*^9, 
   3.941652498596275*^9}, {3.941675549343535*^9, 3.9416755567390394`*^9}, {
   3.941675892243965*^9, 3.941675899298354*^9}, {3.9421126139434547`*^9, 
   3.942112642930793*^9}, 3.96776514525407*^9, {3.9677660171468077`*^9, 
   3.9677660303869023`*^9}, {3.9677661539945374`*^9, 3.967766160330948*^9}, {
   3.967768964944975*^9, 3.967768980474063*^9}, {3.9677690222273192`*^9, 
   3.967769031826388*^9}},
 Background->RGBColor[
  0.88, 1, 0.88],ExpressionUUID->"99d44c34-669d-4b71-b346-0485f7517b48"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Remove", "[", "\"\<Global`*\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{"rx", "=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"x", "[", "1", "]"}], "->", 
     RowBox[{
      RowBox[{"R", " ", 
       RowBox[{"Cos", "[", "\[Theta]", "]"}]}], " ", "+", 
      RowBox[{"r", " ", 
       RowBox[{"Cos", "[", "\[Phi]", "]"}], 
       RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}]}], ",", 
    RowBox[{
     RowBox[{"x", "[", "2", "]"}], "->", 
     RowBox[{
      RowBox[{"R", " ", 
       RowBox[{"Sin", "[", "\[Theta]", "]"}]}], " ", "+", 
      RowBox[{"r", " ", 
       RowBox[{"Cos", "[", "\[Phi]", "]"}], 
       RowBox[{"Sin", "[", "\[Theta]", "]"}]}]}]}], ",", 
    RowBox[{
     RowBox[{"x", "[", "3", "]"}], "->", 
     RowBox[{"r", " ", 
      RowBox[{"Sin", "[", "\[Phi]", "]"}]}]}]}], "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"xx", "=", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"x", "[", "1", "]"}], ",", 
      RowBox[{"x", "[", "2", "]"}], ",", 
      RowBox[{"x", "[", "3", "]"}]}], "}"}], "/.", "rx"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rr1", "=", 
   RowBox[{"D", "[", 
    RowBox[{"xx", ",", "\[Theta]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"rr1", "=", 
  RowBox[{
   RowBox[{
    RowBox[{"rr1", "/", 
     RowBox[{"Norm", "[", "rr1", "]"}]}], "/.", 
    RowBox[{
     RowBox[{
      RowBox[{"Abs", "[", "p_", "]"}], "^", "2"}], "->", 
     RowBox[{"p", "^", "2"}]}]}], "//", "Simplify"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rr2", "=", 
   RowBox[{"D", "[", 
    RowBox[{"xx", ",", "\[Phi]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"rr2", "=", 
  RowBox[{
   RowBox[{
    RowBox[{"rr2", "/", 
     RowBox[{"Norm", "[", "rr1", "]"}]}], "/.", 
    RowBox[{
     RowBox[{
      RowBox[{"Abs", "[", "p_", "]"}], "^", "2"}], "->", 
     RowBox[{"p", "^", "2"}]}]}], "//", "Simplify"}]}], "\[IndentingNewLine]", 
 RowBox[{"rr3", "=", 
  RowBox[{
   RowBox[{"Cross", "[", 
    RowBox[{"rr1", ",", "rr2"}], "]"}], "//", "Simplify"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"r", "=", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"R", "=", "3"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sc", "=", "1."}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"g1", "=", 
   RowBox[{"ParametricPlot3D", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"x", "[", "1", "]"}], ",", 
        RowBox[{"x", "[", "2", "]"}], ",", 
        RowBox[{"x", "[", "3", "]"}]}], "}"}], "/.", "rx"}], ",", 
     RowBox[{"{", 
      RowBox[{"\[Theta]", ",", "0", ",", 
       RowBox[{"2", "Pi"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\[Phi]", ",", "0", ",", 
       RowBox[{"2", "Pi"}]}], "}"}], ",", 
     RowBox[{"Axes", "->", "True"}], ",", 
     RowBox[{"AxesOrigin", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], ",", 
     RowBox[{"AxesStyle", "\[Rule]", 
      RowBox[{"Directive", "[", 
       RowBox[{"Black", ",", "12", ",", "Thick"}], "]"}]}], ",", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"x1", ",", "x2", ",", "x3"}], "}"}]}], ",", 
     RowBox[{"PlotRange", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "5"}], ",", "5"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "5"}], ",", "5"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "2"}], ",", "2"}], "}"}]}], "}"}]}], ",", 
     RowBox[{"PlotStyle", "\[Rule]", 
      RowBox[{"Directive", "[", 
       RowBox[{"Gray", ",", 
        RowBox[{"Opacity", "[", "1.0", "]"}]}], "]"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"g2", "=", 
   RowBox[{"Graphics3D", "[", 
