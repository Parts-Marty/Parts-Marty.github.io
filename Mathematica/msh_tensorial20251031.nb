Cell[BoxData["\<\"If we denote the first term by T, the second to fourth \
terms by effective potential:V[x[2]], and the right-hand side by E, this has \
the form of the law of conservation of energy in classical mechanics, T + V = \
E. Note that the fourth term of V(r), \[Minus]a c^2/(2x[2]), is the term for \
the gravitational field \[Minus]GM/r.\"\>"], "Output",
 CellChangeTimes->{
  3.9440238868074923`*^9, 3.9440240438698874`*^9, 3.944024082300719*^9, 
   3.944024138863572*^9, {3.944027688524619*^9, 3.944027697373393*^9}, 
   3.94407295617384*^9, 3.9440951409023576`*^9, 3.9440960258121367`*^9, {
   3.94409611428822*^9, 3.944096137272256*^9}, {3.944096229768118*^9, 
   3.944096259095341*^9}, 3.9440965239256964`*^9, 3.9440965755589833`*^9, 
   3.9440966453462157`*^9, 3.9440966871026387`*^9},
 CellLabel->
  "Out[199]=",ExpressionUUID->"240e974a-8e0b-47f8-b899-0f963b61383b"]
}, Open  ]]
}, Closed]],

